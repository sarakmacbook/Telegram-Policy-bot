# Copy these into your process manager / secret store. Never commit real credentials.
APP_ENV=production
PORT=8000
DATA_DIR=./data
ADMIN_TOKEN=replace-with-a-long-random-secret
BOT_TOKEN=
WEBHOOK_SECRET=replace-with-a-random-url-safe-secret

# Optional first-run defaults. Admin dashboard settings can change these later.
AUTO_HIDE=0
REVIEW_ALL_MEDIA=0
AUTO_HIDE_MEDIA=0
NOTIFY_CHAT=1
MONITOR_PRIVATE_CHATS=0
JURISDICTIONS=Cambodia
MEDIA_MAX_BYTES=12000000
# Optional JSON: [{"name":"Local review","terms":["phrase one","phrase two"]}]
CUSTOM_RULES_JSON=[]
